[Unit]
Description=Monitor de Alertas Cripto (Barrido de Liquidez + Volume Profile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/smartsoft/arbitraje
EnvironmentFile=/home/ubuntu/smartsoft/arbitraje/.env
ExecStart=/home/ubuntu/smartsoft/arbitraje/venv/bin/python /home/ubuntu/smartsoft/arbitraje/cripto/run_live.py --multi --mode confirmed --telegram
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
